# Copy this file to .env and adjust as needed. See docs/installation.md and
# docs/docker.md for the full walkthrough.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod only:
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.example

# --- Database (also used by the `db` service in docker-compose.yml) ---
POSTGRES_DB=reeler
POSTGRES_USER=reeler
POSTGRES_PASSWORD=reeler
DATABASE_URL=postgres://reeler:reeler@db:5432/reeler

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=1073741824

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=1900
# Runs the whole pipeline synchronously in the web process with no worker —
# handy for a quick local check, but a permanent pipeline failure will raise
# inside the request instead of just marking the video FAILED. Never enable
# in production. See docs/ai_pipeline.md.
CELERY_TASK_ALWAYS_EAGER=false

# --- AI providers ---
# STT: only "faster_whisper" ships today.
AI_STT_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# LLM: "ollama" (local, default) or "openrouter" (hosted, pluggable).
AI_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# CPU-only inference on a several-minute video's transcript can genuinely
# take a few minutes, especially on the first request after container start
# (also pays for loading the model into RAM). Raise further if you still
# see timeouts in `docker compose logs worker` — see docs/ai_pipeline.md.
OLLAMA_TIMEOUT=300

# Only required when AI_LLM_PROVIDER=openrouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120

# --- Scene detection ---
SCENE_DETECTION_THRESHOLD=27.0
SCENE_DETECTION_MIN_SCENE_LEN_SECONDS=0.6

# --- Logging ---
LOG_LEVEL=INFO
